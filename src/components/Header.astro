---
import { Image } from "astro:assets";
import {
  SignInButton,
  SignedIn,
  SignedOut,
  UserButton,
} from "@clerk/astro/components";
---

<header class="py-4 px-4 md:px-16">
  <nav
    class="flex justify-between items-center"
    role="navigation"
    aria-label="Navegación principal"
  >
    <a href="/" aria-label="Ir a inicio">
      <Image src="/logo.webp" alt="FindSong logo" width={150} height={150} />
    </a>

    <ul class="hidden md:flex gap-12 text-lg">
      <li>
        <a href="/" class="hover:text-[#FBB4C5] transition-colors">Inicio</a>
      </li>
      <li>
        <a href="/planes" class="hover:text-[#FBB4C5] transition-colors"
          >Planes</a
        >
      </li>
      <li>
        <a href="/contacto" class="hover:text-[#FBB4C5] transition-colors"
          >Contacto</a
        >
      </li>
    </ul>

    <div class="flex items-center gap-4">
      <SignedOut>
        <SignInButton
          mode="modal"
          class="border-3 border-[#FBB4C5] text-[#FBB4C5] rounded-full px-6 py-1 hover:bg-[#FBB4C5] hover:text-white transition-colors"
        >
          <a
            class="text-lg font-bold"
            style="font-family: 'MuseoModerno', sans-serif;">Iniciar sesión</a
          >
        </SignInButton>

        <button
          class="bg-[#3F3F3F] text-[#FBB4C5] rounded-full px-7 py-1.5 hover:bg-[#FBB4C5] hover:text-white transition-colors"
        >
          <a
            href="/login"
            class="text-lg font-bold"
            style="font-family: 'MuseoModerno', sans-serif;">Registrarse</a
          >
        </button>
      </SignedOut>
      <SignedIn>
        <UserButton showName />
      </SignedIn>
    </div>
  </nav>
</header>
